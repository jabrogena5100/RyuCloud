# Copy to .env (which is git-ignored) and set a real password. Read by docker-compose.yml.
# Use URL-safe characters only (letters/digits), because the password is embedded in DATABASE_URL.
# Generate one with: openssl rand -hex 16
POSTGRES_USER=ryucloud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ryucloud

# Host ports (bound to 127.0.0.1). Change these if something else already uses them.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

LOG_LEVEL=INFO
# Browser origins allowed to make state-changing API requests (comma-separated).
# If you change FRONTEND_HOST_PORT, update these to match.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Object storage (MinIO for local development) -----------------------------
# Root credentials for MinIO itself; only the minio and minio-init services use them.
# Generate: openssl rand -hex 16   (MinIO needs a root password of at least 8 characters)
MINIO_ROOT_USER=ryucloud-minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root
# Least-privilege credentials the API uses (created by minio-init, scoped to one bucket).
S3_ACCESS_KEY_ID=ryucloud-app
S3_SECRET_ACCESS_KEY=change-me-app-secret
S3_BUCKET=ryucloud-media
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Upload limits: largest accepted file (bytes) and how long a presigned URL stays valid.
UPLOAD_MAX_BYTES=1073741824
UPLOAD_URL_TTL_MINUTES=30

# --- Video processing worker (Redis queue + FFmpeg) ---------------------------
# Worker resource limits. The defaults suit a small VM (2+ CPUs, 4+ GB RAM); raise
# them on bigger hosts.
WORKER_CPUS=2
WORKER_MEMORY=2g
# Jobs processed at once (each runs FFmpeg) and threads FFmpeg may use per job.
WORKER_CONCURRENCY=1
FFMPEG_THREADS=2
# Total tries per job before it is failed for good, and the retry delay: base * 2^(attempt-1), capped.
WORKER_MAX_ATTEMPTS=4
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=900
# A claimed job is owned for this long without a heartbeat before another worker may take it.
WORKER_LEASE_SECONDS=120
# Hard limit for processing one job, longest accepted source video, and shutdown patience.
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKER_MAX_DURATION_MINUTES=120
WORKER_SHUTDOWN_GRACE_SECONDS=60
