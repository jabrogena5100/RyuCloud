# Only needed when running the backend directly on your machine (requires Go).
# Docker Compose sets these from the repository-root .env instead.
# Copy to backend/.env, replace the password, and load it into your shell with:
#   set -a; . ./.env; set +a
# Never commit backend/.env.
DATABASE_URL=postgres://ryucloud:change-me@localhost:5432/ryucloud?sslmode=disable
TEST_DATABASE_URL=postgres://ryucloud:change-me@localhost:5432/ryucloud_test?sslmode=disable
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
# Must be true anywhere the site is served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Comma-separated browser origins allowed to make state-changing requests.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_API_DOCS=true
# disabled | memory (in-process, for experiments only)
QUEUE_BACKEND=disabled

# Object storage. Docker Compose sets these itself (STORAGE_BACKEND=s3 against MinIO).
# disabled | s3
STORAGE_BACKEND=disabled
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=ryucloud-media
# S3_ACCESS_KEY_ID=ryucloud-app
# S3_SECRET_ACCESS_KEY=change-me-app-secret
# S3_USE_PATH_STYLE=true
UPLOAD_MAX_BYTES=1073741824
UPLOAD_URL_TTL_MINUTES=30
