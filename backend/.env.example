# Only needed when running the backend directly on your machine (requires Go).
# Docker Compose sets these from the repository-root .env instead.
# Copy to backend/.env, replace the password, and load it into your shell with:
#   set -a; . ./.env; set +a
# Never commit backend/.env.
DATABASE_URL=postgres://ryucloud:change-me@localhost:5432/ryucloud?sslmode=disable
TEST_DATABASE_URL=postgres://ryucloud:change-me@localhost:5432/ryucloud_test?sslmode=disable
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
# Must be true anywhere the site is served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Comma-separated browser origins allowed to make state-changing requests.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_API_DOCS=true
# disabled | memory (in-process, tests only) | redis
QUEUE_BACKEND=disabled
# Required when QUEUE_BACKEND=redis.
# REDIS_URL=redis://localhost:6379/0

# Object storage. Docker Compose sets these itself (STORAGE_BACKEND=s3 against MinIO).
# disabled | s3
STORAGE_BACKEND=disabled
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=ryucloud-media
# S3_ACCESS_KEY_ID=ryucloud-app
# S3_SECRET_ACCESS_KEY=change-me-app-secret
# S3_USE_PATH_STYLE=true
UPLOAD_MAX_BYTES=1073741824
UPLOAD_URL_TTL_MINUTES=30

# Worker settings (cmd/worker). Compose passes these to the worker container.
# WORKER_CONCURRENCY=1
# WORKER_MAX_ATTEMPTS=4
# WORKER_RETRY_BASE_SECONDS=30
# WORKER_RETRY_MAX_SECONDS=900
# WORKER_LEASE_SECONDS=120
# WORKER_JOB_TIMEOUT_SECONDS=1800
# WORKER_MAX_DURATION_MINUTES=120
# WORKER_SHUTDOWN_GRACE_SECONDS=60
# FFMPEG_THREADS=2
# WORKER_TEMP_DIR=/tmp

# --- AWS only (set by the ECS task definitions in infra/terraform; not used locally) ---
# QUEUE_BACKEND=sqs                      # instead of redis
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ryucloud-prod-jobs
# AWS_REGION=us-east-1
# PLAYBACK_BACKEND=cloudfront            # default "api" streams media through the API
# CLOUDFRONT_DOMAIN=media.example.com
# CLOUDFRONT_KEY_PAIR_ID=K2EXAMPLE
# CLOUDFRONT_PRIVATE_KEY=                # PEM; comes from Secrets Manager, never put a real key in a file in Git
# CLOUDFRONT_COOKIE_DOMAIN=example.com   # parent domain of the app and media hosts
# DB_HOST=... DB_NAME=... DB_USER=... DB_PASSWORD=... DB_SSLMODE=require   # used when DATABASE_URL is empty
